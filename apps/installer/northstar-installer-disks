#!/bin/sh

# Read-only FreeBSD disk discovery for the Northstar installer. This helper
# deliberately contains no mutation commands and does not require root.
set -eu

SYSCTL=${NORTHSTAR_INSTALLER_SYSCTL:-/sbin/sysctl}
DISKINFO=${NORTHSTAR_INSTALLER_DISKINFO:-/usr/sbin/diskinfo}
MOUNT=${NORTHSTAR_INSTALLER_MOUNT:-/sbin/mount}
ZPOOL=${NORTHSTAR_INSTALLER_ZPOOL:-/sbin/zpool}
SWAPINFO=${NORTHSTAR_INSTALLER_SWAPINFO:-/usr/sbin/swapinfo}
GEOM=${NORTHSTAR_INSTALLER_GEOM:-/sbin/geom}
MINIMUM_BYTES=17179869184

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 69; }
for tool in "$SYSCTL" "$MOUNT" "$GEOM"; do
    [ -x "$tool" ] || fail "required read-only discovery tool is unavailable: $tool"
done

disks=$($SYSCTL -n kern.disks) || fail 'could not enumerate FreeBSD disks'
usage=$($MOUNT -p 2>/dev/null || true)
if [ -x "$ZPOOL" ]; then usage="$usage
$($ZPOOL status -P 2>/dev/null || true)"; fi
if [ -x "$SWAPINFO" ]; then usage="$usage
$($SWAPINFO -k 2>/dev/null || true)"; fi

# Mounts, pools, and swap can name a provider through GEOM aliases such as
# /dev/msdosfs/NSTAR_EFI or /dev/gpt/NSTAR_ZFS. Resolve only aliases that
# actually occur in the active-usage report; appending every known label would
# incorrectly reject idle destination disks.
label_status=$($GEOM label status 2>/dev/null || true)
alias_components=$(printf '%s\n' "$usage" \
    | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^\/dev\//) print substr($i, 6) }' \
    | while IFS= read -r provider; do
        printf '%s\n' "$label_status" \
            | awk -v provider="$provider" '$1 == provider { print $3 }'
      done)
usage="$usage
$alias_components"

printf '%s\n' 'protocol=2'
for disk in $disks; do
    case "$disk" in
        *[!A-Za-z0-9._-]*|'') continue ;;
    esac
    geom_info=$($GEOM disk list "$disk" 2>/dev/null) || continue
    size=$(printf '%s\n' "$geom_info" | awk -F: '/^[[:space:]]*Mediasize:/ { sub(/^[[:space:]]*/, "", $2); split($2, value, /[[:space:]]/); print value[1]; exit }')
    if [ -z "$size" ] && [ -x "$DISKINFO" ]; then
        info=$($DISKINFO -v "/dev/$disk" 2>/dev/null || true)
        size=$(printf '%s\n' "$info" | awk '/# mediasize in bytes/ { print $1; exit }')
    fi
    case "$size" in *[!0-9]*|'') continue ;; esac
    [ "$size" -gt 0 ] || continue
    sector_size=$(printf '%s\n' "$geom_info" | awk -F: '/^[[:space:]]*Sectorsize:/ { gsub(/[[:space:]]/, "", $2); print $2; exit }')
    case "$sector_size" in 512|4096) ;; *) continue ;; esac

    description="FreeBSD disk $disk"
    discovered=$(printf '%s\n' "$geom_info" \
        | awk -F: '/^[[:space:]]*descr:/ { sub(/^[[:space:]]*/, "", $2); print $2; exit }')
    [ -z "$discovered" ] || description=$discovered
    description=$(printf '%s' "$description" | tr '\t\r\n' '   ' | cut -c1-100)

    system=no
    reason='Available installation destination'
    eligible=yes
    if printf '%s\n' "$usage" | grep -Eq "(^|[^[:alnum:]_])(/dev/)?${disk}((p|s)[0-9]+)?([^[:alnum:]_]|$)"; then
        system=yes
        eligible=no
        reason='Contains the running system, a mounted filesystem, or active swap'
    elif [ "$size" -lt "$MINIMUM_BYTES" ]; then
        eligible=no
        reason='Smaller than the 16 GiB Northstar minimum'
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$disk" "$size" "$sector_size" "$description" unknown "$system" "$eligible" "$reason"
done
