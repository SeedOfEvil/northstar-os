#!/bin/sh
set -eu
EX_USAGE=64
EX_DATAERR=65
EX_UNAVAILABLE=69
EX_NOPERM=77
TEST_MODE=${NORTHSTAR_BLUETOOTH_TEST_MODE:-0}
ROOT=${NORTHSTAR_BLUETOOTH_ROOT:-/}
NODE=${NORTHSTAR_BLUETOOTH_NODE:-ubt0hci}
HCCONTROL=${NORTHSTAR_BLUETOOTH_HCCONTROL_PATH:-/usr/sbin/hccontrol}
SYSRC=${NORTHSTAR_BLUETOOTH_SYSRC_PATH:-/usr/sbin/sysrc}
SERVICE=${NORTHSTAR_BLUETOOTH_SERVICE_PATH:-/usr/sbin/service}
KILL=${NORTHSTAR_BLUETOOTH_KILL_PATH:-/bin/kill}
SSP_AGENT=${NORTHSTAR_BLUETOOTH_SSP_PATH:-/usr/local/libexec/northstar-bluetooth-ssp}
STAT=${NORTHSTAR_BLUETOOTH_STAT_PATH:-/usr/bin/stat}
INSTALL=${NORTHSTAR_BLUETOOTH_INSTALL_PATH:-/usr/bin/install}
fail() { status=$1; shift; printf 'ERROR: %s\n' "$*" >&2; exit "$status"; }
match() { printf '%s\n' "$1" | grep -Eq "$2"; }
root_path() { case "$ROOT" in /) printf '/%s' "$1";; *) printf '%s/%s' "${ROOT%/}" "$1";; esac; }
usage() {
    printf '%s\n' 'Usage: northstar-bluetooth-configure --pair REQUEST | --forget REQUEST | --discoverable on|off'
    exit "$EX_USAGE"
}
unhex() {
    value=$1
    output=
    while [ -n "$value" ]; do
        pair=${value%${value#??}}
        value=${value#??}
        number=$((0x$pair))
        output=$output$(printf "\\$(printf '%03o' "$number")")
    done
    printf '%s' "$output"
}
put_file() {
    mode=$1
    source=$2
    target=$3
    if [ "$TEST_MODE" = 1 ]; then
        "$INSTALL" -m "$mode" "$source" "$target"
    else
        "$INSTALL" -o root -g wheel -m "$mode" "$source" "$target"
    fi
}
filter_device() {
    source=$1
    target=$2
    destination=$3
    awk -v target="$target" '
    function flush() {
        lower=tolower(block)
        pattern="bdaddr[[:space:]]+" tolower(target) "[[:space:]]*;"
        if (lower !~ pattern) printf "%s", block
        block=""
        in_device=0
    }
    {
        if (!in_device && $0 ~ /^[[:space:]]*device[[:space:]]*\{/) {
            in_device=1
            block=$0 ORS
            next
        }
        if (in_device) {
            block=block $0 ORS
            if ($0 ~ /^[[:space:]]*\}[[:space:]]*$/) flush()
            next
        }
        print
    }
    END { if (in_device) printf "%s", block }
    ' "$source" > "$destination"
}
filter_key_file() {
    source=$1
    target=$2
    destination=$3
    awk -v target="$target" 'tolower($1) != tolower(target) { print }' \
        "$source" > "$destination"
}
has_link_key() {
    source=$1
    target=$2
    awk -v target="$target" '
        tolower($1) == tolower(target) && $2 ~ /^[0-9a-fA-F]{32}$/ { found=1 }
        END { exit !found }
    ' "$source" 2>/dev/null
}
read_request() {
    request=$1
    [ -f "$request" ] && [ ! -L "$request" ] && [ -r "$request" ] ||
        fail "$EX_DATAERR" 'the Bluetooth request is missing or unsafe'
    if [ "$TEST_MODE" != 1 ]; then
        [ "$("$STAT" -f %u "$request")" = "$caller" ] &&
            [ "$("$STAT" -f %Lp "$request")" = 600 ] ||
            fail "$EX_NOPERM" 'the Bluetooth request has unsafe ownership or mode'
    fi
    protocol=
    address_hex=
    name_hex=
    count=0
    seen='|'
    while IFS='=' read -r key value || [ -n "${key:-}" ]; do
        [ -n "${key:-}" ] ||
            fail "$EX_DATAERR" 'the Bluetooth request contains a blank field'
        case "$seen" in
            *"|$key|"*) fail "$EX_DATAERR" "the Bluetooth request repeats field: $key";;
        esac
        seen="$seen$key|"
        case "$key" in
            protocol) protocol=$value;;
            address_hex) address_hex=$value;;
            name_hex) name_hex=$value;;
            pin|password|secret|key)
                fail "$EX_DATAERR" 'credential material is forbidden in Bluetooth requests';;
            *) fail "$EX_DATAERR" "the Bluetooth request contains an unknown field: $key";;
        esac
        count=$((count + 1))
    done < "$request"
    [ "$protocol" = 1 ] ||
        fail "$EX_DATAERR" 'the Bluetooth request protocol is invalid'
    match "$address_hex" '^[0-9a-f]{12}$' ||
        fail "$EX_DATAERR" 'the selected Bluetooth address is invalid'
}

case "${1:-}" in
    --pair)
        [ "$#" -eq 2 ] || usage
        operation=pair
        request=$2
        ;;
    --forget)
        [ "$#" -eq 2 ] || usage
        operation=forget
        request=$2
        ;;
    --discoverable)
        [ "$#" -eq 2 ] || usage
        operation=discoverable
        visibility=$2
        case "$visibility" in on|off);; *) usage;; esac
        ;;
    *)
        usage
        ;;
esac
if [ "$TEST_MODE" != 1 ]; then
    [ "$ROOT" = / ] || fail "$EX_NOPERM" 'alternate roots are test-only'
    [ "$(id -u)" -eq 0 ] ||
        fail "$EX_NOPERM" 'protected Bluetooth configuration requires root'
    caller=${PKEXEC_UID:-}
    match "$caller" '^[0-9]+$' ||
        fail "$EX_NOPERM" 'protected Bluetooth configuration requires a PolicyKit caller'
else
    caller=$(id -u)
fi
match "$NODE" '^ubt[0-9]+hci$' ||
    fail "$EX_DATAERR" 'Bluetooth controller name is invalid'

if [ "$operation" = discoverable ]; then
    printf '%s\n' NORTHSTAR_BLUETOOTH_AUTHORIZED=1
    if [ "$visibility" = on ]; then scan=3; else scan=2; fi
    "$HCCONTROL" -n "$NODE" write_scan_enable "$scan" >/dev/null 2>&1 ||
        fail "$EX_UNAVAILABLE" 'Bluetooth visibility could not be changed'
    printf 'NORTHSTAR_BLUETOOTH_DISCOVERABLE=%s\n' "$visibility"
    exit 0
fi

read_request "$request"
address=$(printf '%s' "$address_hex" | sed 's/../&:/g;s/:$//')
hosts=$(root_path etc/bluetooth/hosts)
config=$(root_path etc/bluetooth/hcsecd.conf)
keys=$(root_path var/db/hcsecd.keys)
paired=$(root_path var/db/northstar/bluetooth-paired)
[ -d "${hosts%/*}" ] && [ -f "$config" ] && [ ! -L "$config" ] ||
    fail "$EX_UNAVAILABLE" 'the Bluetooth configuration is unavailable'

if [ "$operation" = pair ]; then
    [ "$count" -eq 3 ] ||
        fail "$EX_DATAERR" 'the Bluetooth pairing request has the wrong number of fields'
    match "$name_hex" '^([0-9a-f][0-9a-f]){1,124}$' ||
        fail "$EX_DATAERR" 'the selected Bluetooth name is invalid'
    [ -x "$SSP_AGENT" ] ||
        fail "$EX_UNAVAILABLE" 'the Secure Simple Pairing agent is unavailable'
    printf '%s\n' NORTHSTAR_BLUETOOTH_AUTHORIZED=1

    friendly=$(unhex "$name_hex" | LC_ALL=C tr -c '[:alnum:] .,_-' '_' | cut -c1-80)
    [ -n "$friendly" ] || friendly='Bluetooth device'
    alias=$(printf '%s' "$friendly" | tr ' ' '_' | cut -c1-80)
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/northstar-bluetooth.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT HUP INT TERM
    hosts_backup=$tmp/hosts.backup
    config_backup=$tmp/hcsecd.backup
    keys_backup=$tmp/keys.backup
    paired_backup=$tmp/paired.backup
    hosts_candidate=$tmp/hosts.candidate
    config_candidate=$tmp/hcsecd.candidate
    keys_candidate=$tmp/keys.candidate
    paired_candidate=$tmp/paired.candidate
    had_hosts=0
    had_keys=0
    had_paired=0
    if [ -f "$hosts" ] && [ ! -L "$hosts" ]; then
        had_hosts=1
        cp "$hosts" "$hosts_backup"
        awk -v target="$address" 'tolower($1) != tolower(target) { print }' \
            "$hosts" > "$hosts_candidate"
    else
        : > "$hosts_candidate"
    fi
    printf '%s\t%s\n' "$address" "$alias" >> "$hosts_candidate"
    cp "$config" "$config_backup"
    if [ -f "$keys" ] && [ ! -L "$keys" ]; then
        had_keys=1
        cp "$keys" "$keys_backup"
        filter_key_file "$keys" "$address" "$keys_candidate"
    fi
    if [ -f "$paired" ] && [ ! -L "$paired" ]; then
        had_paired=1
        cp "$paired" "$paired_backup"
    fi
    filter_device "$config" "$address" "$config_candidate"
    {
        printf '\n# Managed by Northstar Bluetooth\n'
        printf 'device {\n'
        printf '\tbdaddr\t%s;\n' "$address"
        printf '\tname\t"%s";\n' "$friendly"
        printf '\tkey\tnokey;\n'
        printf '\tpin\tnopin;\n'
        printf '}\n'
    } >> "$config_candidate"

    rollback_pair() {
        "$SERVICE" hcsecd onestop >/dev/null 2>&1 || true
        put_file 0600 "$config_backup" "$config" >/dev/null 2>&1 || true
        if [ "$had_hosts" -eq 1 ]; then
            put_file 0644 "$hosts_backup" "$hosts" >/dev/null 2>&1 || true
        else
            rm -f "$hosts"
        fi
        if [ "$had_keys" -eq 1 ]; then
            put_file 0600 "$keys_backup" "$keys" >/dev/null 2>&1 || true
        else
            rm -f "$keys"
        fi
        if [ "$had_paired" -eq 1 ]; then
            put_file 0644 "$paired_backup" "$paired" >/dev/null 2>&1 || true
        else
            rm -f "$paired"
        fi
        "$SERVICE" hcsecd onestart >/dev/null 2>&1 || true
    }
    put_file 0644 "$hosts_candidate" "$hosts" ||
        fail "$EX_UNAVAILABLE" 'the Bluetooth hosts file could not be installed'
    put_file 0600 "$config_candidate" "$config" || {
        rollback_pair
        fail "$EX_UNAVAILABLE" 'the Bluetooth pairing configuration could not be installed'
    }
    if [ "$had_keys" -eq 1 ]; then
        put_file 0600 "$keys_candidate" "$keys" || {
            rollback_pair
            fail "$EX_UNAVAILABLE" 'the stale Bluetooth link key could not be removed'
        }
    fi
    "$HCCONTROL" -n "$NODE" delete_stored_link_key "$address" \
        >/dev/null 2>&1 || true
    "$SYSRC" -R "$ROOT" hcsecd_enable=YES >/dev/null || {
        rollback_pair
        fail "$EX_UNAVAILABLE" 'the Bluetooth pairing service could not be enabled'
    }
    "$SERVICE" hcsecd onerestart >/dev/null 2>&1 || {
        rollback_pair
        fail "$EX_UNAVAILABLE" 'the Bluetooth pairing service could not be restarted'
    }
    if ! "$SSP_AGENT" --listen "$NODE" "$address"; then
        rollback_pair
        fail "$EX_UNAVAILABLE" 'Secure Simple Pairing did not complete'
    fi
    key_persisted=0
    attempts=0
    while [ "$attempts" -lt 5 ]; do
        attempts=$((attempts + 1))
        hcsecd_pid=$(cat "$(root_path var/run/hcsecd.pid)" 2>/dev/null || true)
        match "$hcsecd_pid" '^[0-9]+$' || {
            rollback_pair
            fail "$EX_UNAVAILABLE" 'the Bluetooth pairing service PID is unavailable'
        }
        "$KILL" -HUP "$hcsecd_pid" >/dev/null 2>&1 || {
            rollback_pair
            fail "$EX_UNAVAILABLE" 'the Bluetooth link key could not be persisted'
        }
        sleep 1
        if has_link_key "$keys" "$address"; then
            key_persisted=1
            break
        fi
    done
    [ "$key_persisted" -eq 1 ] || {
        rollback_pair
        fail "$EX_UNAVAILABLE" 'the device did not provide a persistent Bluetooth link key'
    }
    mkdir -p "${paired%/*}"
    if [ "$had_paired" -eq 1 ]; then
        awk -v target="$address" 'tolower($1) != tolower(target) { print }' \
            "$paired_backup" > "$paired_candidate"
    else
        : > "$paired_candidate"
    fi
    printf '%s\n' "$address" >> "$paired_candidate"
    put_file 0644 "$paired_candidate" "$paired" || {
        rollback_pair
        fail "$EX_UNAVAILABLE" 'the paired-device state could not be recorded'
    }
    printf '%s\n' NORTHSTAR_BLUETOOTH_PAIR=PASS
    exit 0
fi

[ "$count" -eq 2 ] && [ -z "$name_hex" ] ||
    fail "$EX_DATAERR" 'the Bluetooth forget request has the wrong fields'
printf '%s\n' NORTHSTAR_BLUETOOTH_AUTHORIZED=1
tmp=$(mktemp -d "${TMPDIR:-/tmp}/northstar-bluetooth-forget.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
hosts_backup=$tmp/hosts.backup
config_backup=$tmp/hcsecd.backup
keys_backup=$tmp/keys.backup
paired_backup=$tmp/paired.backup
hosts_candidate=$tmp/hosts.candidate
config_candidate=$tmp/hcsecd.candidate
keys_candidate=$tmp/keys.candidate
paired_candidate=$tmp/paired.candidate
had_hosts=0
had_keys=0
had_paired=0
"$SERVICE" hcsecd onestop >/dev/null 2>&1 || true
cp "$config" "$config_backup"
filter_device "$config" "$address" "$config_candidate"
if [ -f "$hosts" ] && [ ! -L "$hosts" ]; then
    had_hosts=1
    cp "$hosts" "$hosts_backup"
    awk -v target="$address" 'tolower($1) != tolower(target) { print }' \
        "$hosts" > "$hosts_candidate"
else
    : > "$hosts_candidate"
fi
if [ -f "$keys" ] && [ ! -L "$keys" ]; then
    had_keys=1
    cp "$keys" "$keys_backup"
    filter_key_file "$keys" "$address" "$keys_candidate"
fi
if [ -f "$paired" ] && [ ! -L "$paired" ]; then
    had_paired=1
    cp "$paired" "$paired_backup"
    awk -v target="$address" 'tolower($1) != tolower(target) { print }' \
        "$paired" > "$paired_candidate"
fi

rollback_forget() {
    put_file 0600 "$config_backup" "$config" >/dev/null 2>&1 || true
    if [ "$had_hosts" -eq 1 ]; then
        put_file 0644 "$hosts_backup" "$hosts" >/dev/null 2>&1 || true
    else
        rm -f "$hosts"
    fi
    if [ "$had_keys" -eq 1 ]; then
        put_file 0600 "$keys_backup" "$keys" >/dev/null 2>&1 || true
    fi
    if [ "$had_paired" -eq 1 ]; then
        put_file 0644 "$paired_backup" "$paired" >/dev/null 2>&1 || true
    fi
    "$SERVICE" hcsecd onestart >/dev/null 2>&1 || true
}
put_file 0644 "$hosts_candidate" "$hosts" || {
    rollback_forget
    fail "$EX_UNAVAILABLE" 'the Bluetooth hosts file could not be updated'
}
put_file 0600 "$config_candidate" "$config" || {
    rollback_forget
    fail "$EX_UNAVAILABLE" 'the Bluetooth pairing configuration could not be updated'
}
if [ "$had_keys" -eq 1 ]; then
    put_file 0600 "$keys_candidate" "$keys" || {
        rollback_forget
        fail "$EX_UNAVAILABLE" 'the Bluetooth link-key cache could not be updated'
    }
fi
if [ "$had_paired" -eq 1 ]; then
    put_file 0644 "$paired_candidate" "$paired" || {
        rollback_forget
        fail "$EX_UNAVAILABLE" 'the paired-device state could not be updated'
    }
fi
handle=$("$HCCONTROL" -n "$NODE" read_connection_list 2>/dev/null |
    awk -v target="$address" 'tolower($1) == tolower(target) { print $2; exit }')
if match "$handle" '^[0-9]+$'; then
    "$HCCONTROL" -n "$NODE" disconnect "$handle" 0x16 >/dev/null 2>&1 || true
fi
"$HCCONTROL" -n "$NODE" delete_stored_link_key "$address" >/dev/null 2>&1 || true
"$SERVICE" hcsecd onestart >/dev/null 2>&1 || {
    rollback_forget
    fail "$EX_UNAVAILABLE" 'the Bluetooth pairing service could not be restarted'
}
printf '%s\n' NORTHSTAR_BLUETOOTH_FORGET=PASS
