#!/bin/sh

set -eu

PENDING=${NORTHSTAR_FIRST_BOOT_PENDING:-/var/db/northstar/first-boot.pending}
COMPLETE=${NORTHSTAR_FIRST_BOOT_COMPLETE:-/var/db/northstar/first-boot.conf}
WIZARD=${NORTHSTAR_FIRST_BOOT_BIN:-/usr/local/libexec/northstar-first-boot}

[ "$(id -u)" -ne 0 ] || {
    printf '%s\n' 'ERROR: first-boot session must be unprivileged' >&2
    exit 77
}
[ -f "$PENDING" ] && [ ! -L "$PENDING" ] || {
    printf '%s\n' 'ERROR: this installation is not awaiting first-boot setup' >&2
    exit 77
}
[ ! -e "$COMPLETE" ] || {
    printf '%s\n' 'ERROR: first-boot setup is already complete' >&2
    exit 77
}
[ -x "$WIZARD" ] || {
    printf '%s\n' "ERROR: first-boot wizard is unavailable: $WIZARD" >&2
    exit 69
}

[ -n "${DISPLAY:-}" ] || {
    printf '%s\n' 'ERROR: first-boot session requires an SDDM X11 DISPLAY' >&2
    exit 69
}

# FreeBSD SDDM can start an X11 user session without exporting a usable
# XAUTHORITY path. Resolve only an owner-matched, mode-0600 cookie that proves
# it authorizes this display, matching the normal Northstar image launcher.
auth_works=0
if [ -n "${XAUTHORITY:-}" ] && [ -f "$XAUTHORITY" ] && [ -r "$XAUTHORITY" ]; then
    if xauth -f "$XAUTHORITY" list "$DISPLAY" 2>/dev/null | grep -q .; then
        auth_works=1
    fi
fi
if [ "$auth_works" -eq 0 ]; then
    current_uid=$(id -u)
    resolved_authority=
    for candidate in /tmp/xauth_*; do
        [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -r "$candidate" ] || continue
        [ "$(stat -f '%u' "$candidate")" = "$current_uid" ] || continue
        [ "$(stat -f '%Lp' "$candidate")" = 600 ] || continue
        if xauth -f "$candidate" list "$DISPLAY" 2>/dev/null | grep -q .; then
            [ -z "$resolved_authority" ] || {
                printf '%s\n' 'ERROR: multiple usable SDDM Xauthority files were found' >&2
                exit 69
            }
            resolved_authority=$candidate
        fi
    done
    [ -n "$resolved_authority" ] || {
        printf '%s\n' 'ERROR: no usable SDDM Xauthority file was found' >&2
        exit 69
    }
    XAUTHORITY=$resolved_authority
    export XAUTHORITY
fi

export QT_QPA_PLATFORM=xcb
export XDG_SESSION_TYPE=x11

# Bare-X11 sessions have no window manager to correct a conservative initial
# mode. Ask every connected output to use its preferred mode before Qt reads
# Screen.width/height; retain the current mode if the optional tool fails.
if command -v xrandr >/dev/null 2>&1; then
    xrandr --auto >/tmp/northstar-first-boot-xrandr.log 2>&1 || \
        printf '%s\n' 'WARNING: could not select preferred display mode' >&2
fi

exec "$WIZARD"
