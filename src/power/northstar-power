#!/bin/sh

# Fixed-argument power boundary for the Northstar shell. The installed file is
# root-owned and PolicyKit authorizes only this executable. Validate the one
# enumerated action before re-entering the exact installed path as root, so no
# caller-provided command or option can reach shutdown(8).

set -eu

ID=${NORTHSTAR_POWER_ID_PATH:-/usr/bin/id}
PKEXEC=${NORTHSTAR_POWER_PKEXEC_PATH:-/usr/local/bin/pkexec}
SELF=${NORTHSTAR_POWER_SELF_PATH:-/usr/local/bin/northstar-power}
SHUTDOWN=${NORTHSTAR_POWER_SHUTDOWN_PATH:-/sbin/shutdown}
ACPICONF=${NORTHSTAR_POWER_ACPICONF_PATH:-/usr/sbin/acpiconf}
SYSCTL=${NORTHSTAR_POWER_SYSCTL_PATH:-/sbin/sysctl}
SYSRC=${NORTHSTAR_POWER_SYSRC_PATH:-/usr/sbin/sysrc}
SYSCTL_CONF=${NORTHSTAR_POWER_SYSCTL_CONF:-/etc/sysctl.conf}

[ "$#" -eq 1 ] || exit 64

case "$1" in
    restart|shutdown|suspend|lid-suspend-on|lid-suspend-off) ;;
    *) exit 64 ;;
esac

if [ "$("$ID" -u)" -ne 0 ]; then
    exec "$PKEXEC" "$SELF" "$1"
fi

case "$1" in
    restart) exec "$SHUTDOWN" -r now ;;
    shutdown) exec "$SHUTDOWN" -p now ;;
    suspend)
        # Detach the fixed suspend request so the shell can finish closing its
        # confirmation surface before the machine enters S3.
        "$ACPICONF" -s 3 </dev/null >/dev/null 2>&1 &
        exit 0
        ;;
    lid-suspend-on)
        "$SYSRC" -f "$SYSCTL_CONF" hw.acpi.lid_switch_state=S3
        exec "$SYSCTL" hw.acpi.lid_switch_state=S3
        ;;
    lid-suspend-off)
        "$SYSRC" -f "$SYSCTL_CONF" hw.acpi.lid_switch_state=NONE
        exec "$SYSCTL" hw.acpi.lid_switch_state=NONE
        ;;
esac
