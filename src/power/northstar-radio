#!/bin/sh

# Fixed-argument radio boundary for the Northstar shell.
#
# The shell runs unprivileged and must never be able to construct a command
# line here. This helper therefore accepts only an enumerated pair of words and
# resolves the interface itself, so no caller-supplied string ever reaches
# ifconfig, service, or sudo.
#
# The installed root-owned helper re-enters itself through sudo only after the
# two fixed words have been validated. First Boot authorizes only the four
# exact installed-helper invocations, never raw ifconfig or service commands.

set -eu

SUDO=${NORTHSTAR_RADIO_SUDO_PATH:-/usr/local/bin/sudo}
IFCONFIG=${NORTHSTAR_RADIO_IFCONFIG_PATH:-/sbin/ifconfig}
SERVICE=${NORTHSTAR_RADIO_SERVICE_PATH:-/usr/sbin/service}
ID=${NORTHSTAR_RADIO_ID_PATH:-/usr/bin/id}
SELF=${NORTHSTAR_RADIO_SELF_PATH:-/usr/local/bin/northstar-radio}

usage_error=64
unavailable=69

[ "$#" -eq 2 ] || exit "$usage_error"

case "$2" in
    on|off) ;;
    *) exit "$usage_error" ;;
esac

case "$1" in
    wifi|bluetooth) ;;
    *) exit "$usage_error" ;;
esac

if [ "$("$ID" -u)" -ne 0 ]; then
    exec "$SUDO" -n "$SELF" "$1" "$2"
fi

# The first wireless interface the kernel reports. Never an argument.
wireless_interface() {
    "$IFCONFIG" -l 2>/dev/null | tr ' ' '\n' | grep -E '^wlan[0-9]+$' | head -1
}

restart_wifi_services() {
    interface=$1

    # Quick Settings allows less than a second for this helper. Reconnect in a
    # detached subshell, with every inherited descriptor closed, so the UI can
    # report the radio as enabled while association and DHCP finish normally.
    (
        "$SERVICE" wpa_supplicant restart "$interface" \
            || "$SERVICE" wpa_supplicant start "$interface"
        "$SERVICE" dhclient restart "$interface" \
            || "$SERVICE" dhclient start "$interface"
    ) </dev/null >/dev/null 2>&1 &
}

case "$1" in
    wifi)
        interface=$(wireless_interface)
        [ -n "$interface" ] || exit "$unavailable"
        if [ "$2" = on ]; then
            "$IFCONFIG" "$interface" up
            restart_wifi_services "$interface"
            exit 0
        else
            exec "$IFCONFIG" "$interface" down
        fi
        ;;
    bluetooth)
        # The stack is started and stopped as a whole; there is no per-device
        # enable that survives a controller reset.
        if [ "$2" = on ]; then
            exec "$SERVICE" bluetooth start
        else
            exec "$SERVICE" bluetooth stop
        fi
        ;;
esac
