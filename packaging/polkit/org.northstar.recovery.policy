<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Northstar</vendor>
  <vendor_url>https://github.com/SeedOfEvil/northstar-os</vendor_url>
  <action id="org.northstar.recovery.activate-boot-environment">
    <description>Select a verified Northstar recovery point for the next boot</description>
    <message>Administrator authentication is required to select a Northstar recovery point</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/northstar-boot-environment</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
