<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>Northstar</vendor>
  <action id="org.northstar.storage.readonly">
    <description>Mount or unmount a removable volume read-only</description>
    <message>Administrator authentication is required to manage this removable volume</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/northstar-storage</annotate>
  </action>
</policyconfig>
